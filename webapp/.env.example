# Variáveis só de servidor — nunca use o prefixo NEXT_PUBLIC_ para segredos
# (tudo que começa com NEXT_PUBLIC_ é copiado para o JavaScript enviado ao navegador).

# URL do Space da API (sem barra no final)
STABILIS_API_URL=https://amaroguilherme-stabilis-api.hf.space

# Token fine-grained do Hugging Face com permissão apenas de leitura no Space
HF_SPACE_TOKEN=
