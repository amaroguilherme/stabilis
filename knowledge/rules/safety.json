      "applies_to": "global",
      "modes": [
        "patient",
        "professional"
      ],
      "when": {
        "any": [
          {
            "not": {
              "profile": "age",
              "op": "exists"
            }
          },
          {
            "not": {
              "profile": "sex_at_birth",
              "op": "exists"
            }
          }
        ]
      },
      "then": [
        {
          "action": "exclude_medications",
          "scope": "all"
        },
        {
          "action": "alert",
