    "segment_split": "[.!?;:\\n]+",
    "normalization": "NFKD, remove marcas diacríticas, minúsculas, tudo que não é [0-9a-z] vira espaço",
    "negation_window_tokens": 6,
    "negation_modes": [
      "professional"
    ],
    "count_token": "{N+} numa expressão casa com qualquer número inteiro a partir de N (ex.: \"tomei {10+} comprimidos\")"
